<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Atlas Technologies | Building a Smarter Tomorrow</title>

    <meta name="description"
          content="Atlas Technologies builds modern software, mobile applications, AI solutions and digital systems that move businesses forward.">

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

<!-- ================= HEADER ================= -->

<header class="header">

    <div class="container nav">

        <a href="#home" class="logo">
            <img src="images/atlas-logo.png" alt="Atlas Technologies">
        </a>

        <nav id="main-nav">

            <a href="#home" class="active">Home</a>
            <a href="#services">Services</a>
            <a href="#portfolio">Portfolio</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>

            <a href="#contact" class="nav-button">
                Start a Project
            </a>

        </nav>

        <button class="menu-toggle"
                id="menu-toggle"
                aria-label="Open navigation">
            ☰
        </button>

    </div>

</header>


<!-- ================= MAIN ================= -->

<main>


<!-- ================= HERO ================= -->

<section class="hero" id="home">

    <div class="hero-background"></div>
    <div class="hero-glow"></div>

    <div class="container hero-content">

        <div class="hero-text">

            <p class="eyebrow">
                ATLAS TECHNOLOGIES
            </p>

            <h1>
                We Build Technology
                <span>That Moves Business Forward.</span>
            </h1>

            <p class="hero-description">
                Atlas Technologies develops modern software, mobile
                applications, AI solutions and digital systems that
                help businesses grow, work smarter and stay ahead
                in a digital world.
            </p>

            <div class="hero-buttons">

                <a href="#contact" class="btn btn-primary">
                    Start a Project
                    <span>→</span>
                </a>

                <a href="#portfolio" class="btn btn-secondary">
                    Explore Our Work
                </a>

            </div>

            <div class="hero-features">

                <div>
                    <span class="feature-icon">&lt;/&gt;</span>
                    <span>Modern Software</span>
                </div>

                <div>
                    <span class="feature-icon">▣</span>
                    <span>Mobile Applications</span>
                </div>

                <div>
                    <span class="feature-icon">AI</span>
                    <span>AI Solutions</span>
                </div>

                <div>
                    <span class="feature-icon">☁</span>
                    <span>Digital Systems</span>
                </div>

            </div>

        </div>


        <div class="hero-visual">

            <div class="planet-glow"></div>

            <div class="hero-logo-wrap">

                <img src="images/atlas-logo.png"
                     alt="Atlas Technologies Logo">

                <div class="hero-tagline">
                    INNOVATE&nbsp;&nbsp;•&nbsp;&nbsp;BUILD&nbsp;&nbsp;•&nbsp;&nbsp;GROW
                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================= SERVICES ================= -->

<section class="services section" id="services">

    <div class="container">

        <div class="section-intro">

            <p class="section-label">
                OUR SERVICES
            </p>

            <h2>
                Solutions for a
                <span>Smarter Tomorrow.</span>
            </h2>

            <p>
                We deliver high-quality, scalable and innovative
                digital solutions tailored to your business needs.
            </p>

        </div>


        <div class="services-grid">

            <article class="service-card">

                <div class="service-icon">&lt;/&gt;</div>

                <h3>Custom Software Development</h3>

                <p>
                    Powerful, scalable and secure software built
                    around your business.
                </p>

            </article>


            <article class="service-card">

                <div class="service-icon">▣</div>

                <h3>Mobile Applications</h3>

                <p>
                    iOS and Android applications that connect
                    you with your users.
                </p>

            </article>


            <article class="service-card">

                <div class="service-icon">AI</div>

                <h3>AI & Automation</h3>

                <p>
                    Intelligent solutions designed to work
                    smarter and faster.
                </p>

            </article>


            <article class="service-card">

                <div class="service-icon">◎</div>

                <h3>Web Applications</h3>

                <p>
                    Modern, fast and responsive web platforms
                    for growing businesses.
                </p>

            </article>


            <article class="service-card">

                <div class="service-icon">♙</div>

                <h3>IT Consulting</h3>

                <p>
                    Expert guidance for your digital
                    transformation journey.
                </p>

            </article>

        </div>

    </div>

</section>


<!-- ================= PORTFOLIO ================= -->

<section class="portfolio section" id="portfolio">

    <div class="container">

        <div class="portfolio-heading">

            <div>

                <p class="section-label">
                    OUR PORTFOLIO
                </p>

                <h2>
                    Featured <span>Projects.</span>
                </h2>

                <p>
                    Real solutions. Real results. Explore some
                    of our recent work.
                </p>

            </div>

            <a href="#contact" class="view-projects">
                View All Projects →
            </a>

        </div>


        <div class="portfolio-grid">


            <article class="project-card">

                <div class="project-image skincare">
                    <span>Mobile App</span>
                </div>

                <div class="project-content">

                    <h3>Lass Skin Care</h3>

                    <p>
                        A modern skincare mobile app with
                        product catalog, bookings and more.
                    </p>

                    <a href="#contact">
                        View Project →
                    </a>

                </div>

            </article>


            <article class="project-card">

                <div class="project-image evo">
                    <span>AI Solution</span>
                </div>

                <div class="project-content">

                    <h3>EVO AI Assistant</h3>

                    <p>
                        A smart AI assistant built for
                        productivity and real-time support.
                    </p>

                    <a href="#contact">
                        View Project →
                    </a>

                </div>

            </article>


            <article class="project-card">

                <div class="project-image dashboard">
                    <span>Web App</span>
                </div>

                <div class="project-content">

                    <h3>Business Dashboard</h3>

                    <p>
                        A powerful analytics dashboard for
                        better decision making.
                    </p>

                    <a href="#contact">
                        View Project →
                    </a>

                </div>

            </article>


            <article class="project-card">

                <div class="project-image ecommerce">
                    <span>Mobile & Web</span>
                </div>

                <div class="project-content">

                    <h3>E-Commerce Platform</h3>

                    <p>
                        Complete online store with secure
                        payments and easy management.
                    </p>

                    <a href="#contact">
                        View Project →
                    </a>

                </div>

            </article>

        </div>

    </div>

</section>


<!-- ================= ABOUT ================= -->

<section class="about section" id="about">

    <div class="container about-content">

        <div class="about-text">

            <p class="section-label">
                ABOUT ATLAS TECHNOLOGIES
            </p>

            <h2>
                Innovation.
                <span>Expertise.</span>
                Results.
            </h2>

            <p>
                At Atlas Technologies, we believe in the power
                of technology to create real opportunities.
                We are a team of passionate developers,
                designers and problem-solvers dedicated to
                building digital solutions that make a difference.
            </p>

            <a href="#contact" class="btn btn-primary">
                Learn More About Us →
            </a>

        </div>


        <div class="stats">

            <div class="stat">
                <strong>10+</strong>
                <span>Projects Completed</span>
            </div>

            <div class="stat">
                <strong>100%</strong>
                <span>Client Satisfaction</span>
            </div>

            <div class="stat">
                <strong>24/7</strong>
                <span>Support & Maintenance</span>
            </div>

        </div>

    </div>

</section>


<!-- ================= CONTACT ================= -->

<section class="contact section" id="contact">

    <div class="container contact-grid">

        <div class="contact-info">

            <p class="section-label">
                GET IN TOUCH
            </p>

            <h2>
                Let's Build
                <span>Something Great.</span>
            </h2>

            <p>
                Have a project in mind? We'd love to hear from you.
                Send us a message and we'll get back to you as
                soon as possible.
            </p>


            <div class="contact-details">

                <div class="contact-item">

                    <div class="contact-icon">✉</div>

                    <div>
                        <small>Email</small>
                        <a href="mailto:info@atlast ech.co.sz">
                            info@atlast ech.co.sz
                        </a>
                    </div>

                </div>


                <div class="contact-item">

                    <div class="contact-icon">☎</div>

                    <div>
                        <small>Phone</small>
                        <a href="tel:+26878482172">
                            +268 7848 2172
                        </a>
                    </div>

                </div>


                <div class="contact-item">

                    <div class="contact-icon">●</div>

                    <div>
                        <small>Location</small>
                        <span>Centurion, Gauteng, South Africa</span>
                    </div>

                </div>

            </div>

        </div>


        <form class="contact-form"
      action="https://formspree.io/f/mdeowrza"
      method="POST">

    <div class="form-row">

        <input type="text"
               name="name"
               placeholder="Full Name"
               autocomplete="name"
               required>

        <input type="email"
               name="email"
               placeholder="Email Address"
               autocomplete="email"
               required>

    </div>

    <input type="text"
           name="company"
           placeholder="Company (Optional)"
           autocomplete="organization">

    <select name="service" required>
        <option value="" disabled selected>Select a Service</option>
        <option value="Software Development">Software Development</option>
        <option value="Mobile Applications">Mobile Applications</option>
        <option value="AI & Automation">AI & Automation</option>
        <option value="Web Development">Web Development</option>
        <option value="Digital Systems">Digital Systems</option>
        <option value="Other">Other</option>
    </select>

    <input type="text"
           name="subject"
           placeholder="Subject"
           required>

    <textarea name="message"
              rows="7"
              placeholder="Tell us about your project..."
              required></textarea>

    <input type="text"
           name="_gotcha"
           tabindex="-1"
           autocomplete="off"
           style="position:absolute;left:-9999px;">

    <input type="hidden"
           name="_subject"
           value="New Atlas Technologies Project Enquiry">

    <button type="submit" class="btn btn-primary">
        Send Message →
    </button>

</form>


        <div class="contact-features">

            <div>
                <strong>⚡</strong>
                <div>
                    <b>Fast Response</b>
                    <small>We reply within 24 hours.</small>
                </div>
            </div>

            <div>
                <strong>◇</strong>
                <div>
                    <b>Secure</b>
                    <small>Your information is safe with us.</small>
                </div>
            </div>

            <div>
                <strong>✦</strong>
                <div>
                    <b>Dedicated Support</b>
                    <small>We're here to help.</small>
                </div>
            </div>

        </div>

    </div>

</section>


</main>


<!-- ================= FOOTER ================= -->

<footer class="footer">

    <div class="container footer-content">

        <a href="#home" class="footer-logo">
            <img src="images/atlas-logo.png"
                 alt="Atlas Technologies">
        </a>

        <p>
            © <span id="year"></span> Atlas Technologies.
            All rights reserved.
        </p>

        <div class="footer-social">

            <a href="#" aria-label="GitHub">GH</a>
            <a href="#" aria-label="LinkedIn">in</a>
            <a href="#" aria-label="X">X</a>
            <a href="#" aria-label="YouTube">▶</a>

        </div>

        <div class="footer-motto">
            Innovate&nbsp;&nbsp;•&nbsp;&nbsp;Build&nbsp;&nbsp;•&nbsp;&nbsp;Grow
        </div>

    </div>

</footer>


<script>

const menuToggle = document.getElementById("menu-toggle");
const nav = document.getElementById("main-nav");

menuToggle.addEventListener("click", () => {
    nav.classList.toggle("active");
});

document.querySelectorAll("#main-nav a").forEach(link => {
    link.addEventListener("click", () => {
        nav.classList.remove("active");
    });
});

document.getElementById("year").textContent =
    new Date().getFullYear();

</script>

</body>
</html>
