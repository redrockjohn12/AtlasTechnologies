<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Atlas Technologies | Building Technology. Solving Problems.</title>

    <meta name="description"
          content="Atlas Technologies builds modern software, websites, mobile applications, AI solutions and business systems.">

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- ================= HEADER ================= -->
    <header class="header">
        <div class="container nav">

            <a href="#" class="logo">
                <img src="images/atlas-logo.png" alt="Atlas Technologies">
            </a>

            <button class="menu-toggle" id="menuToggle" aria-label="Open menu">
                ☰
            </button>

            <nav id="navigation">
                <a href="#home">Home</a>
                <a href="#services">Services</a>
                <a href="#solutions">Solutions</a>
                <a href="#products">Products</a>
                <a href="#about">About</a>
                <a href="#contact" class="nav-button">Start a Project</a>
            </nav>

        </div>
    </header>


    <!-- ================= HERO ================= -->
    <main>

        <section class="hero" id="home">

            <div class="hero-grid"></div>

            <div class="container hero-content">

                <div class="hero-text">

                    <p class="eyebrow">ATLAS TECHNOLOGIES</p>

                    <h1>
                        We Build Technology
                        <span>That Moves Business Forward.</span>
                    </h1>

                    <p class="hero-description">
                        Atlas Technologies develops modern software, mobile
                        applications, AI solutions and digital systems that
                        help businesses grow.
                    </p>

                    <div class="hero-buttons">
                        <a href="#contact" class="btn btn-primary">
                            Start a Project
                        </a>

                        <a href="#products" class="btn btn-secondary">
                            Explore Our Work
                        </a>
                    </div>

                </div>


                <div class="hero-card">

                    <div class="card-glow"></div>

                    <div class="code-window">

                        <div class="window-top">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>

                        <div class="code">
                            <p><span class="purple">const</span> atlas = {</p>
                            <p>&nbsp;&nbsp;vision:
                                <span class="green">
                                    "Build the future"
                                </span>,
                            </p>

                            <p>&nbsp;&nbsp;innovation:
                                <span class="green">
                                    true
                                </span>,
                            </p>

                            <p>&nbsp;&nbsp;technology:
                                <span class="green">
                                    "Unlimited"
                                </span>
                            </p>

                            <p>};</p>

                            <p class="cursor">_</p>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- ================= SERVICES ================= -->

        <section class="section" id="services">

            <div class="container">

                <div class="section-heading">

                    <p class="eyebrow">WHAT WE DO</p>

                    <h2>
                        Technology Built Around
                        <span>Your Goals.</span>
                    </h2>

                    <p>
                        From an idea to a complete digital platform,
                        Atlas Technologies builds solutions designed
                        around real-world problems.
                    </p>

                </div>


                <div class="services-grid">

                    <article class="service-card">
                        <div class="service-icon">⌘</div>
                        <h3>Software Development</h3>
                        <p>
                            Custom software designed to improve
                            business operations and solve complex
                            problems.
                        </p>
                    </article>


                    <article class="service-card">
                        <div class="service-icon">◈</div>
                        <h3>Web Development</h3>
                        <p>
                            Modern websites, web applications,
                            online stores and digital platforms.
                        </p>
                    </article>


                    <article class="service-card">
                        <div class="service-icon">▣</div>
                        <h3>Mobile Applications</h3>
                        <p>
                            Powerful mobile experiences for Android
                            and iOS users.
                        </p>
                    </article>


                    <article class="service-card">
                        <div class="service-icon">✦</div>
                        <h3>AI & Automation</h3>
                        <p>
                            Intelligent systems and automation that
                            help businesses work smarter.
                        </p>
                    </article>


                    <article class="service-card">
                        <div class="service-icon">▤</div>
                        <h3>Business Systems</h3>
                        <p>
                            CRM, inventory, POS, booking and
                            management systems.
                        </p>
                    </article>


                    <article class="service-card">
                        <div class="service-icon">☁</div>
                        <h3>Cloud & Data</h3>
                        <p>
                            Databases, APIs, hosting, integrations
                            and scalable infrastructure.
                        </p>
                    </article>

                </div>

            </div>

        </section>


        <!-- ================= SOLUTIONS ================= -->

        <section class="section dark-section" id="solutions">

            <div class="container">

                <div class="section-heading">

                    <p class="eyebrow">OUR APPROACH</p>

                    <h2>
                        We Don't Just Write Code.
                        <span>We Solve Problems.</span>
                    </h2>

                </div>


                <div class="solutions">

                    <div class="solution">
                        <span>01</span>
                        <div>
                            <h3>Understand</h3>
                            <p>
                                We understand your business,
                                your customers and the problem
                                you need solved.
                            </p>
                        </div>
                    </div>


                    <div class="solution">
                        <span>02</span>
                        <div>
                            <h3>Design</h3>
                            <p>
                                We design a clear and practical
                                digital solution around your goals.
                            </p>
                        </div>
                    </div>


                    <div class="solution">
                        <span>03</span>
                        <div>
                            <h3>Build</h3>
                            <p>
                                We turn the idea into reliable,
                                modern software.
                            </p>
                        </div>
                    </div>


                    <div class="solution">
                        <span>04</span>
                        <div>
                            <h3>Grow</h3>
                            <p>
                                We improve and maintain the system
                                as your business grows.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </section>


        <!-- ================= PRODUCTS ================= -->

        <section class="section" id="products">

            <div class="container">

                <div class="section-heading">

                    <p class="eyebrow">ATLAS PRODUCTS</p>

                    <h2>
                        Technology
                        <span>We Are Building.</span>
                    </h2>

                    <p>
                        Atlas Technologies doesn't only build for
                        clients. We build our own technology too.
                    </p>

                </div>


                <div class="products-grid">

                    <article class="product-card">

                        <div class="product-number">01</div>

                        <h3>Atlas AI</h3>

                        <p>
                            An intelligent AI platform designed to
                            assist users, automate tasks and interact
                            with digital systems.
                        </p>

                        <span class="status">
                            In Development
                        </span>

                    </article>


                    <article class="product-card">

                        <div class="product-number">02</div>

                        <h3>SwapEasy</h3>

                        <p>
                            A digital marketplace designed to make
                            buying and selling easier.
                        </p>

                        <span class="status">
                            In Development
                        </span>

                    </article>


                    <article class="product-card">

                        <div class="product-number">03</div>

                        <h3>Future Products</h3>

                        <p>
                            New software products created by Atlas
                            Technologies to solve everyday problems.
                        </p>

                        <span class="status">
                            Coming Soon
                        </span>

                    </article>

                </div>

            </div>

        </section>


        <!-- ================= ABOUT ================= -->

        <section class="section dark-section" id="about">

            <div class="container about">

                <div>

                    <p class="eyebrow">ABOUT ATLAS</p>

                    <h2>
                        Building For
                        <span>What's Next.</span>
                    </h2>

                </div>

                <div class="about-text">

                    <p>
                        Atlas Technologies is a software development
                        company focused on creating practical,
                        innovative and scalable digital solutions.
                    </p>

                    <p>
                        Our mission is simple: use technology to
                        solve problems, create opportunities and
                        help businesses move forward.
                    </p>

                </div>

            </div>

        </section>


        <!-- ================= CONTACT ================= -->

        <section class="section contact-section" id="contact">

            <div class="container contact">

                <div class="contact-info">

                    <p class="eyebrow">START A PROJECT</p>

                    <h2>
                        Have an Idea?
                        <span>Let's Build It.</span>
                    </h2>

                    <p>
                        Tell Atlas Technologies what you're trying
                        to build. We'll turn the idea into a plan.
                    </p>

                </div>


                <form class="contact-form" id="contactForm">

                    <input
                        type="text"
                        placeholder="Your Name"
                        required
                    >

                    <input
                        type="email"
                        placeholder="Your Email"
                        required
                    >

                    <input
                        type="text"
                        placeholder="Business / Company"
                    >

                    <textarea
                        rows="6"
                        placeholder="Tell us about your project..."
                        required
                    ></textarea>

                    <button type="submit" class="btn btn-primary">
                        Send Project Request
                    </button>

                </form>

            </div>

        </section>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="footer">

        <div class="container footer-content">

            <div>

                <div class="logo">
                    <span class="logo-mark">A</span>
                    <span>ATLAS TECHNOLOGIES</span>
                </div>

                <p>
                    Building Technology. Solving Problems.
                </p>

            </div>


            <div class="footer-links">

                <a href="#home">Home</a>
                <a href="#services">Services</a>
                <a href="#products">Products</a>
                <a href="#contact">Contact</a>

            </div>

        </div>


        <div class="copyright">

            © 2026 Atlas Technologies. All rights reserved.

        </div>

    </footer>


    <script src="js/script.js"></script>

</body>
</html>
