* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #050914;
    color: #ffffff;
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

.container {
    width: min(1120px, 92%);
    margin: auto;
}

/* ================= HEADER ================= */

.header {
    position: relative;
    width: 100%;
    z-index: 1000;
    background: rgba(5, 9, 20, 0.95);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.nav {
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

.logo img {
    width: 385px;
    height: 320px;
    max-height: 320px;
    object-fit: contain;
    display: block;
}

.logo-mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 2px solid #3da9ff;
    border-radius: 10px;
    color: #3da9ff;
    font-size: 20px;
}

.logo-tech {
    color: #3da9ff;
}

nav {
    display: flex;
    align-items: center;
    gap: 25px;
}

nav a {
    color: #c7cedb;
    font-size: 14px;
    transition: 0.3s;
}

nav a:hover {
    color: #3da9ff;
}

.nav-button {
    padding: 11px 17px;
    border: 1px solid #3da9ff;
    border-radius: 8px;
    color: #ffffff !important;
}

.menu-toggle {
    display: none;
    background: transparent;
    border: 0;
    color: #ffffff;
    font-size: 28px;
}

/* ================= HERO ================= */

.hero {
    min-height: auto;
    padding: 0 0 80px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.hero-grid {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(61, 169, 255, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(61, 169, 255, 0.05) 1px, transparent 1px);
    background-size: 55px 55px;
    mask-image: linear-gradient(to bottom, black, transparent);
    pointer-events: none;
}

.hero-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
    position: relative;
}

.eyebrow {
    color: #3da9ff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: clamp(42px, 6vw, 76px);
    line-height: 1.05;
    max-width: 750px;
}

.hero h1 span,
.section-heading h2 span,
.about h2 span,
.contact-info h2 span {
    color: #3da9ff;
}

.hero-description {
    max-width: 600px;
    margin: 25px 0;
    color: #aeb8c8;
    font-size: 18px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    display: inline-block;
    padding: 14px 23px;
    border-radius: 8px;
    font-weight: 700;
    border: 1px solid transparent;
    cursor: pointer;
    transition: 0.3s;
}

.btn-primary {
    background: #3da9ff;
    color: #03101c;
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(61, 169, 255, 0.25);
}

.btn-secondary {
    border-color: rgba(255, 255, 255, 0.18);
    color: #ffffff;
}

.btn-secondary:hover {
    border-color: #3da9ff;
}

/* ================= CODE CARD ================= */

.hero-card {
    position: relative;
}

.card-glow {
    position: absolute;
    width: 260px;
    height: 260px;
    background: #3da9ff;
    opacity: 0.12;
    filter: blur(80px);
    top: 30px;
    right: 30px;
}

.code-window {
    position: relative;
    background: #0b1220;
    border: 1px solid rgba(61, 169, 255, 0.2);
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.45);
}

.window-top {
    height: 45px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 17px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.window-top span {
    width: 10px;
    height: 10px;
    background: #3d4655;
    border-radius: 50%;
}

.code {
    padding: 30px;
    font-family: monospace;
    font-size: 14px;
    color: #d7deea;
}

.code p {
    margin-bottom: 12px;
}

.purple {
    color: #c792ea;
}

.green {
    color: #7ee787;
}

.cursor {
    color: #3da9ff;
    animation: blink 1s infinite;
}

@keyframes blink {
    50% {
        opacity: 0;
    }
}

/* ================= SECTIONS ================= */

.section {
    padding: 110px 0;
}

.dark-section {
    background: #080e1b;
}

.section-heading {
    max-width: 700px;
    margin-bottom: 55px;
}

.section-heading h2,
.about h2,
.contact-info h2 {
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.1;
    margin-bottom: 20px;
}

.section-heading > p:last-child,
.contact-info > p:last-child {
    color: #aeb8c8;
}

/* ================= SERVICES ================= */

.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.service-card {
    padding: 30px;
    background: #0b1220;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    transition: 0.3s;
}

.service-card:hover {
    transform: translateY(-7px);
    border-color: rgba(61, 169, 255, 0.5);
}

.service-icon {
    width: 45px;
    height: 45px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: rgba(61, 169, 255, 0.1);
    color: #3da9ff;
    font-size: 23px;
    margin-bottom: 20px;
}

.service-card h3 {
    margin-bottom: 10px;
}

.service-card p,
.product-card p,
.solution p,
.about-text p {
    color: #aeb8c8;
}

/* ================= SOLUTIONS ================= */

.solutions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.solution {
    display: flex;
    gap: 25px;
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
}

.solution > span {
    color: #3da9ff;
    font-size: 14px;
    font-weight: bold;
}

.solution h3 {
    margin-bottom: 8px;
}

/* ================= PRODUCTS ================= */

.products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.product-card {
    padding: 35px;
    min-height: 280px;
    background: linear-gradient(145deg, #0d1727, #09101d);
    border: 1px solid rgba(61, 169, 255, 0.15);
    border-radius: 15px;
}

.product-number {
    color: #3da9ff;
    font-weight: bold;
    margin-bottom: 45px;
}

.product-card h3 {
    font-size: 25px;
    margin-bottom: 12px;
}

.status {
    display: inline-block;
    margin-top: 25px;
    padding: 6px 11px;
    border-radius: 20px;
    background: rgba(61, 169, 255, 0.1);
    color: #3da9ff;
    font-size: 12px;
}

/* ================= ABOUT ================= */

.about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.about-text {
    display: grid;
    gap: 20px;
}

/* ================= CONTACT ================= */

.contact-section {
    background: #050914;
}

.contact {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 70px;
}

.contact-form {
    display: grid;
    gap: 15px;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 16px;
    background: #0b1220;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #ffffff;
    font: inherit;
    outline: none;
}

.contact-form input:focus,
.contact-form textarea:focus {
    border-color: #3da9ff;
}

.contact-form textarea {
    resize: vertical;
}

/* ================= FOOTER ================= */

.footer {
    padding: 45px 0 20px;
    background: #03060d;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
}

.footer-content {
    display: flex;
    justify-content: space-between;
    gap: 30px;
}

.footer p {
    color: #7f8a9b;
    margin-top: 12px;
}

.footer-links {
    display: flex;
    gap: 25px;
}

.footer-links a {
    color: #aeb8c8;
    font-size: 14px;
}

.copyright {
    text-align: center;
    margin-top: 35px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: #687386;
    font-size: 13px;
}

/* ================= MOBILE ================= */

@media (max-width: 850px) {

    .nav {
        min-height: 320px;
    }

    .logo img {
        width: 385px;
        height: 320px;
        max-height: 320px;
        object-fit: contain;
        display: block;
    }

    .menu-toggle {
        display: block;
    }

    nav {
        display: none;
        position: absolute;
        top: 320px;
        left: 4%;
        width: 92%;
        padding: 20px;
        flex-direction: column;
        align-items: stretch;
        background: #0b1220;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
    }

    nav.active {
        display: flex;
    }

    nav a {
        padding: 10px;
    }

    .hero {
        min-height: auto;
        padding: 0 0 60px;
    }

    .hero-content,
    .about,
    .contact {
        grid-template-columns: 1fr;
    }

    .hero-card {
        display: none;
    }

    .hero h1 {
        font-size: clamp(40px, 12vw, 58px);
    }

    .hero-description {
        font-size: 16px;
        margin: 20px 0;
    }

    .services-grid,
    .products-grid,
    .solutions {
        grid-template-columns: 1fr;
    }

    .section {
        padding: 80px 0;
    }

    .footer-content {
        flex-direction: column;
    }

    .footer-links {
        flex-wrap: wrap;
    }
}

/* ================= SMALL PHONES ================= */

@media (max-width: 480px) {

    .container {
        width: 90%;
    }

    .logo img {
        width: 385px;
        height: 320px;
        max-height: 320px;
        object-fit: contain;
        display: block;
    }

    .hero {
        min-height: auto;
        padding: 0 0 50px;
    }

    .hero h1 {
        font-size: 39px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .btn {
        text-align: center;
    }

    .section {
        padding: 65px 0;
    }
}
