* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #020711;
    color: #f5f8ff;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.5;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input,
textarea,
select {
    font: inherit;
}

.container {
    width: min(1180px, 90%);
    margin: auto;
}

/* HEADER */

.header {
    height: 65px;
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;
    background: rgba(1, 6, 13, .94);
    border-bottom: 1px solid rgba(0, 132, 255, .2);
    backdrop-filter: blur(15px);
}

.nav {
    height: 65px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo img {
    width: 215px;
    display: block;
}

#main-nav {
    display: flex;
    align-items: center;
    gap: 35px;
}

#main-nav a {
    color: #aebed1;
    font-size: 12px;
    font-weight: 600;
    transition: .3s;
}

#main-nav a:hover,
#main-nav a.active {
    color: #08a8ff;
}

.nav-button {
    padding: 10px 20px;
    border-radius: 9px;
    color: white !important;
    background: linear-gradient(135deg,#08a9ff,#1557e9);
    box-shadow: 0 5px 25px rgba(0,120,255,.25);
}

.menu-toggle {
    display: none;
    border: 0;
    background: none;
    color: white;
    font-size: 26px;
}

/* HERO */

.hero {
    min-height: 575px;
    padding-top: 65px;
    position: relative;
    overflow: hidden;

    background-image: url("../images/hero-space.png");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            90deg,
            rgba(1,6,14,.99) 0%,
            rgba(1,7,16,.94) 27%,
            rgba(1,7,16,.55) 49%,
            rgba(1,7,16,.05) 82%
        );
}

.hero-content {
    height: 510px;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 2;
}

.hero-text {
    width: 55%;
}

.eyebrow,
.section-label {
    color: #08a8ff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.hero h1 {
    max-width: 610px;
    font-size: clamp(40px,4.7vw,61px);
    line-height: 1.05;
    letter-spacing: -2px;
    margin-bottom: 18px;
}

.hero h1 span {
    display: block;
    color: #08a8ff;
    text-shadow: 0 0 25px rgba(0,150,255,.25);
}

.hero-description {
    max-width: 520px;
    color: #9aacbf;
    font-size: 13px;
    line-height: 1.7;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 25px;
}

.btn {
    min-height: 43px;
    padding: 0 20px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    border-radius: 9px;
    font-size: 11px;
    font-weight: 700;
    transition: .3s;
}

.btn-primary {
    border: 0;
    color: white;
    background: linear-gradient(135deg,#08aaff,#0759e8);
    box-shadow: 0 7px 25px rgba(0,120,255,.22);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(0,145,255,.4);
}

.btn-secondary {
    border: 1px solid #176ca8;
    color: #d3e4f6;
    background: rgba(1,15,31,.65);
}

.hero-features {
    display: flex;
    gap: 25px;
    margin-top: 27px;
}

.hero-features div {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #8196ac;
    font-size: 9px;
}

.hero-features i {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #09a8ff;
    background: rgba(0,130,255,.1);
    border: 1px solid rgba(0,145,255,.3);
    font-style: normal;
    font-size: 9px;
    font-weight: bold;
}

/* SECTIONS */

.section {
    padding: 43px 0;
    border-top: 1px solid rgba(0,100,190,.16);
}

.section-heading {
    margin-bottom: 23px;
}

.section-heading h2,
.portfolio-heading h2,
.about h2,
.contact h2 {
    font-size: 28px;
    line-height: 1.15;
    margin-bottom: 7px;
}

.section-heading h2 span,
.portfolio-heading h2 span,
.about h2 span,
.contact h2 span {
    color: #f4f8ff;
}

.section-heading > p:last-child,
.portfolio-heading p,
.about-text > p,
.contact-info > p {
    color: #8195aa;
    font-size: 11px;
}

/* SERVICES */

.services {
    background:
        radial-gradient(circle at 50% 0%,rgba(0,100,210,.08),transparent 45%),
        #020914;
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(5,1fr);
    gap: 17px;
}

.service-card {
    min-height: 155px;
    padding: 18px;
    border-radius: 8px;
    border: 1px solid rgba(0,110,205,.27);
    background: linear-gradient(145deg,#06182d,#03101f);
    transition: .3s;
}

.service-card:hover {
    transform: translateY(-5px);
    border-color: #078fe7;
    box-shadow: 0 10px 30px rgba(0,90,180,.15);
}

.service-icon {
    width: 37px;
    height: 37px;
    margin-bottom: 13px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #09a8ff;
    background: rgba(0,135,255,.1);
    border: 1px solid rgba(0,145,255,.3);
    font-size: 11px;
    font-weight: bold;
}

.service-icon.ai {
    color: #20d995;
    border-color: rgba(0,220,140,.3);
    background: rgba(0,200,130,.08);
}

.service-card h3 {
    font-size: 12px;
    line-height: 1.3;
    margin-bottom: 7px;
}

.service-card p {
    color: #71869c;
    font-size: 9px;
    line-height: 1.5;
}

/* PORTFOLIO */

.portfolio {
    background: #010711;
}

.portfolio-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 23px;
}

.view-projects {
    border: 1px solid #087dc6;
    padding: 8px 15px;
    border-radius: 8px;
    color: #10a8ff;
    font-size: 9px;
}

.portfolio-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 17px;
}

.project-card {
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid rgba(0,110,205,.25);
    background: #041020;
    transition: .3s;
}

.project-card:hover {
    transform: translateY(-5px);
    border-color: #078fe7;
}

.project-image {
    height: 135px;
    position: relative;
    overflow: hidden;
}

.project-image > span {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 5;
    padding: 4px 7px;
    border-radius: 5px;
    background: rgba(0,20,45,.85);
    border: 1px solid rgba(0,150,255,.35);
    color: #52bfff;
    font-size: 7px;
}

.skincare {
    background:
        radial-gradient(circle at 20% 30%,#e6b4b4,transparent 25%),
        linear-gradient(135deg,#b98686,#271622);
}

.evo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background:
        radial-gradient(circle,#07579c,transparent 25%),
        #020b19;
}

.evo-title {
    color: #20aaff;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 4px;
    text-shadow: 0 0 20px #078fe7;
}

.evo small {
    color: #4e9dcb;
    font-size: 6px;
    letter-spacing: 2px;
}

.dashboard {
    background: linear-gradient(135deg,#061a30,#071326);
}

.dashboard-screen {
    width: 65%;
    height: 80%;
    margin: 14px auto;
    padding: 12px;
    border: 2px solid #174d77;
    border-radius: 5px;
    background: #020914;
    box-shadow: 0 0 25px rgba(0,130,255,.2);
}

.dashboard-screen div {
    height: 18%;
    margin-bottom: 7px;
    border-radius: 2px;
    background: linear-gradient(90deg,#0c65a7,#0b2b4b);
}

.dashboard-screen div:nth-child(2) {
    width: 70%;
}

.dashboard-screen div:nth-child(3) {
    width: 85%;
}

.dashboard-screen div:nth-child(4) {
    width: 55%;
}

.ecommerce {
    background:
        radial-gradient(circle at 70% 35%,#708c43,transparent 28%),
        linear-gradient(135deg,#1c2b20,#0b1510);
}

.store-screen {
    width: 58%;
    height: 78%;
    margin: 15px auto;
    padding: 9px;
    background: #07121b;
    border: 2px solid #274c58;
    border-radius: 5px;
}

.store-screen div {
    display: inline-block;
    width: 29%;
    height: 55%;
    margin: 3px;
    border-radius: 3px;
    background: linear-gradient(#f4f4f4,#7e8ea0);
}

.project-content {
    padding: 13px;
}

.project-content h3 {
    font-size: 12px;
    margin-bottom: 4px;
}

.project-content p {
    min-height: 39px;
    color: #71869b;
    font-size: 9px;
    line-height: 1.5;
}

.project-content a {
    color: #08a8ff;
    font-size: 9px;
    font-weight: bold;
}

/* ABOUT */

.about {
    background:
        radial-gradient(circle at 85% 45%,rgba(0,100,210,.13),transparent 35%),
        #020b17;
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    align-items: center;
}

.about-text h2 {
    margin-bottom: 15px;
}

.about-text > p {
    max-width: 520px;
    line-height: 1.8;
    margin-bottom: 22px;
}

.about-visual {
    position: relative;
    min-height: 190px;
}

.desk {
    height: 150px;
    position: relative;
    border-radius: 15px;
    background: linear-gradient(145deg,#091b2e,#030b15);
    border: 1px solid #123c60;
    box-shadow: 0 20px 50px rgba(0,0,0,.3);
}

.monitor {
    width: 55%;
    height: 80%;
    position: absolute;
    left: 20%;
    top: 9%;
    padding: 7px;
    border: 4px solid #142e46;
    border-radius: 5px;
    background: #020810;
    box-shadow: 0 0 25px rgba(0,120,255,.18);
}

.screen-code {
    height: 100%;
    padding: 13px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    background:
        linear-gradient(135deg,rgba(0,125,255,.1),transparent),
        #030c18;
}

.screen-code b {
    color: #08a8ff;
    font-size: 10px;
}

.screen-code span {
    color: #557994;
    font-size: 7px;
}

.coffee {
    position: absolute;
    right: 10%;
    bottom: 20px;
    width: 28px;
    height: 35px;
    border-radius: 3px 3px 10px 10px;
    background: #071d30;
    border: 2px solid #16527b;
}

.stats {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 17px;
}

.stats div {
    text-align: center;
    min-width: 90px;
}

.stats strong {
    display: block;
    font-size: 21px;
}

.stats small {
    color: #71869d;
    font-size: 7px;
}

/* CONTACT */

.contact {
    position: relative;
    overflow: hidden;
    background: #020914;
}

.contact-map {
    position: absolute;
    inset: 0;
    opacity: .12;
    background:
        radial-gradient(circle at 20% 50%,#0878c5 0,transparent 22%),
        radial-gradient(circle at 70% 40%,#0878c5 0,transparent 18%);
}

.contact-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 20px;
}

.contact h2 {
    margin-bottom: 12px;
}

.contact-info > p {
    max-width: 430px;
    line-height: 1.7;
}

.contact-details {
    margin-top: 25px;
    display: grid;
    gap: 15px;
}

.contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
}

.contact-item > i {
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #08a8ff;
    background: rgba(0,130,255,.1);
    border: 1px solid rgba(0,145,255,.25);
    font-style: normal;
    font-size: 11px;
}

.contact-item small,
.contact-item span {
    display: block;
}

.contact-item small {
    color: #687e95;
    font-size: 8px;
}

.contact-item span {
    color: #c1d2e4;
    font-size: 10px;
}

.contact-form {
    padding: 20px;
    border: 1px solid rgba(0,115,210,.28);
    border-radius: 10px;
    background: rgba(3,17,33,.82);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.contact-form input,
.contact-form textarea,
.contact-form select {
    width: 100%;
    margin-bottom: 10px;
    padding: 11px 12px;
    outline: none;
    color: #dcecff;
    background: #020b16;
    border: 1px solid rgba(40,110,175,.3);
    border-radius: 7px;
    font-size: 9px;
}

.contact-form select {
    appearance: auto;
}

.contact-form textarea {
    height: 110px;
    resize: vertical;
}

.contact-form input:focus,
.contact-form textarea:focus,
.contact-form select:focus {
    border-color: #08a8ff;
}

.contact-form .btn {
    width: 100%;
    cursor: pointer;
}

.contact-features {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 10px;
}

.contact-features > div {
    padding: 12px;
    display: flex;
    gap: 9px;
    border-radius: 7px;
    border: 1px solid rgba(0,110,200,.2);
    background: rgba(3,20,38,.6);
}

.contact-features b {
    color: #08a8ff;
    font-size: 16px;
}

.contact-features strong,
.contact-features small {
    display: block;
}

.contact-features strong {
    font-size: 9px;
}

.contact-features small {
    color: #6d8298;
    font-size: 7px;
}

/* FOOTER */

.footer {
    padding: 18px 0;
    background: #01060d;
    border-top: 1px solid rgba(0,110,205,.18);
}

.footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.footer img {
    width: 145px;
}

.footer p,
.footer-content > span {
    color: #60758a;
    font-size: 8px;
}

.footer-social {
    display: flex;
    gap: 7px;
}

.footer-social a {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(100,140,175,.25);
    border-radius: 50%;
    color: #8195aa;
    font-size: 7px;
}

/* MOBILE */

@media (max-width: 950px) {

    .services-grid {
        grid-template-columns: repeat(3,1fr);
    }

    .portfolio-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .hero-text {
        width: 65%;
    }

    .about-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {

    .logo img {
        width: 175px;
    }

    .menu-toggle {
        display: block;
    }

    #main-nav {
        position: absolute;
        top: 65px;
        left: 0;
        width: 100%;
        display: none;
        flex-direction: column;
        padding: 20px;
        background: #020914;
        border-bottom: 1px solid #0a3f68;
    }

    #main-nav.active {
        display: flex;
    }

    .hero {
        min-height: 650px;
        background-position: 65% center;
    }

    .hero-overlay {
        background:
            linear-gradient(
                180deg,
                rgba(1,6,14,.98),
                rgba(1,7,16,.88) 45%,
                rgba(1,7,16,.5)
            );
    }

    .hero-content {
        height: auto;
        min-height: 585px;
    }

    .hero-text {
        width: 100%;
    }

    .hero h1 {
        font-size: 39px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-features {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 13px;
    }

    .services-grid,
    .portfolio-grid {
        grid-template-columns: 1fr;
    }

    .portfolio-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .contact-grid {
        grid-template-columns: 1fr;
    }

    .contact-features {
        grid-column: auto;
        grid-template-columns: 1fr;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .footer-content {
        flex-direction: column;
        text-align: center;
    }
}

/* =========================================================
   FINAL MOBILE FIX — Samsung A12 / SMALL SCREENS
   ========================================================= */

@media (max-width: 600px) {

    html,
    body {
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
    }

    .container {
        width: 100%;
        max-width: 100%;
        padding-left: 18px;
        padding-right: 18px;
    }

    /* Mobile header */
    header {
        height: 62px;
    }

    .header-inner {
        min-height: 62px;
    }

    .logo img {
        width: 135px;
        max-width: 70%;
    }

    #main-nav {
        top: 62px;
    }

    /* HERO */
    .hero {
        min-height: 720px;
        padding-top: 62px;

        /*
         * Keep Earth on the right while giving the text
         * enough clean space on the left.
         */
        background-position: 72% center;
        background-size: auto 100%;
    }

    .hero-overlay {
        background:
            linear-gradient(
                180deg,
                rgba(1, 6, 14, .98) 0%,
                rgba(1, 7, 16, .94) 42%,
                rgba(1, 7, 16, .72) 72%,
                rgba(1, 7, 16, .35) 100%
            );
    }

    .hero-content {
        min-height: 650px;
        height: auto;
        align-items: flex-start;
        padding-top: 55px;
    }

    .hero-text {
        width: 100%;
        max-width: 100%;
    }

    .eyebrow {
        font-size: 9px;
        letter-spacing: 2.5px;
        margin-bottom: 12px;
    }

    .hero h1 {
        width: 100%;
        max-width: 100%;
        font-size: clamp(31px, 9vw, 39px);
        line-height: 1.08;
        letter-spacing: -1px;
        margin-bottom: 16px;
        overflow-wrap: normal;
        word-break: normal;
    }

    .hero h1 span {
        display: block;
    }

    .hero-description {
        width: 100%;
        max-width: 330px;
        font-size: 12px;
        line-height: 1.6;
    }

    .hero-buttons {
        width: 100%;
        max-width: 300px;
        flex-direction: column;
        gap: 10px;
        margin-top: 20px;
    }

    .hero-buttons .btn {
        width: 100%;
        justify-content: center;
    }

    /* Hero feature cards */
    .hero-features {
        width: 100%;
        max-width: 340px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 28px;
    }

    .hero-feature {
        min-width: 0;
        padding: 10px 5px;
    }

    .hero-feature h3 {
        font-size: 10px;
    }

    .hero-feature p {
        font-size: 9px;
    }

    /* Sections */
    section {
        overflow: hidden;
    }

    .section-heading h2 {
        font-size: 30px;
    }

    /* Services */
    .services-grid,
    .portfolio-grid {
        grid-template-columns: 1fr;
    }

    /* Contact */
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .contact-features {
        grid-template-columns: 1fr;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    /* Footer */
    .footer-content {
        flex-direction: column;
        text-align: center;
    }
}

/* Extra-small phones */
@media (max-width: 380px) {

    .container {
        padding-left: 15px;
        padding-right: 15px;
    }

    .hero {
        min-height: 700px;
        background-position: 70% center;
    }

    .hero-content {
        padding-top: 48px;
    }

    .hero h1 {
        font-size: 32px;
    }

    .hero-description {
        font-size: 11.5px;
    }

    .hero-features {
        gap: 5px;
    }
}


/* =========================================================
   HERO BLEND FIX — KEEP CURRENT DESIGN
   ========================================================= */

.hero {
    position: relative;
    isolation: isolate;
}

/* Fade the bottom of the Earth image into the page */
.hero::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 110px;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
        to bottom,
        rgba(1, 7, 16, 0) 0%,
        rgba(1, 7, 16, .45) 45%,
        #010710 100%
    );
}

/* Keep the actual hero content above the fade */
.hero-content {
    position: relative;
    z-index: 3;
}

.hero-overlay {
    z-index: 2;
}

/* =========================================================
   MOBILE HERO — FULL WIDTH FIX
   ========================================================= */

@media (max-width: 600px) {

    .hero {
        width: 100%;
        max-width: 100%;
        min-height: 720px;
        margin: 0;
        padding-top: 62px;

        /* Fill the entire phone width */
        background-size: cover;
        background-position: 62% center;
        background-repeat: no-repeat;
    }

    .hero-overlay {
        width: 100%;
        height: 100%;
        left: 0;
        right: 0;
    }

    .hero-content {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding-left: 18px;
        padding-right: 18px;
        box-sizing: border-box;
    }

    .hero-text {
        width: 100%;
        max-width: 100%;
    }

    .hero h1 {
        max-width: 100%;
    }

    .hero-description {
        max-width: 320px;
    }
}

@media (max-width: 380px) {

    .hero {
        width: 100%;
        max-width: 100%;
        background-size: cover;
        background-position: 60% center;
    }

    .hero-content {
        padding-left: 15px;
        padding-right: 15px;
    }
}

