/* ATLAS FREE EARTH HERO */

.hero {
    position: relative;
    overflow: hidden;
}

.hero-layout {
    position: relative;
    z-index: 3;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    min-height: 760px;
}

.hero-copy {
    position: relative;
    z-index: 8;
}

.hero-visual {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: -10%;
    width: 72%;
    height: 125%;
    transform: translateY(-50%);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

.hero-image-glow {
    position: absolute;
    width: 72%;
    height: 72%;
    right: 8%;
    top: 14%;
    border-radius: 50%;
    background: rgba(0, 140, 255, 0.34);
    filter: blur(90px);
    opacity: 0.75;
    animation: imageGlow 7s ease-in-out infinite;
}

.hero-image-frame {
    position: relative;
    width: 125%;
    height: 125%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    overflow: visible;
    isolation: isolate;
}

.hero-image-frame::before,
.hero-image-frame::after {
    display: none;
}

.hero-earth {
    position: relative;
    z-index: 3;
    display: block;
    width: 118%;
    max-width: none;
    height: auto;
    margin-right: -12%;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
    object-fit: contain;
    mix-blend-mode: screen;
    filter:
        brightness(1.08)
        contrast(1.08)
        saturate(1.12)
        drop-shadow(0 0 35px rgba(0, 150, 255, 0.34));
    -webkit-mask-image: radial-gradient(
        ellipse 66% 72% at 57% 50%,
        #000 48%,
        rgba(0,0,0,.96) 60%,
        rgba(0,0,0,.72) 72%,
        rgba(0,0,0,.28) 84%,
        transparent 100%
    );
    mask-image: radial-gradient(
        ellipse 66% 72% at 57% 50%,
        #000 48%,
        rgba(0,0,0,.96) 60%,
        rgba(0,0,0,.72) 72%,
        rgba(0,0,0,.28) 84%,
        transparent 100%
    );
    animation: heroFloat 8s ease-in-out infinite;
}

.hero-image-meta,
.floating-stat {
    display: none;
}

.hero::after {
    content: "";
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    width: 62%;
    height: 100%;
    pointer-events: none;
    background:
        linear-gradient(
            90deg,
            rgba(3, 10, 24, 0) 0%,
            rgba(3, 10, 24, 0.03) 35%,
            rgba(3, 10, 24, 0.12) 72%,
            rgba(3, 10, 24, 0.28) 100%
        );
}

@media (max-width: 1050px) {
    .hero-layout {
        min-height: 700px;
        grid-template-columns: 1fr;
    }

    .hero-visual {
        right: -18%;
        width: 76%;
        height: 105%;
        opacity: 0.72;
    }

    .hero-copy {
        max-width: 720px;
    }

    .hero-earth {
        width: 115%;
    }
}

@media (max-width: 760px) {
    .hero {
        min-height: 760px;
    }

    .hero-layout {
        min-height: 760px;
    }

    .hero-visual {
        top: auto;
        bottom: -4%;
        right: -32%;
        width: 105%;
        height: 58%;
        transform: none;
        opacity: 0.62;
    }

    .hero-image-frame {
        width: 125%;
        height: 125%;
    }

    .hero-earth {
        width: 118%;
        margin-right: 0;
    }

    .hero::after {
        width: 100%;
        height: 70%;
        top: auto;
        bottom: 0;
        background:
            linear-gradient(
                180deg,
                rgba(3, 10, 24, 0) 0%,
                rgba(3, 10, 24, 0.18) 55%,
                rgba(3, 10, 24, 0.72) 100%
            );
    }
}
