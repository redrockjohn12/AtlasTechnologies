.marquee{border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;background:#04172a}.marquee-track{width:max-content;display:flex;align-items:center;gap:30px;padding:20px 0;color:#708aa1;font-size:9px;letter-spacing:.24em;white-space:nowrap;animation:marquee 34s linear infinite}.marquee-track b{color:var(--blue)}
.statement{background:linear-gradient(180deg,#031326,#061d34)}.statement-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:90px;margin-top:42px}.statement h2,.section-intro h2,.proof-head h2,.solutions-copy h2,.impact h2,.about-grid h2,.process-head h2,.final-cta h2,.contact-copy h2{font-size:clamp(42px,5.6vw,72px);line-height:1.02;letter-spacing:-.05em;margin:0}.statement h2 em{font-style:normal;color:#8ba7bc}.statement h2 span,.section-intro h2 span,.proof-head h2 span,.solutions-copy h2 span,.impact h2 span,.about-grid h2 span,.process-head h2 span,.final-cta h2 span,.contact-copy h2 span{color:var(--blue)}.statement-copy{border-top:1px solid var(--line);padding-top:26px}.statement-copy p{color:var(--muted);line-height:1.85;font-size:14px}.statement-copy p+p{margin-top:24px}
.proof{background:#04182b}.proof-head{display:grid;grid-template-columns:1fr .65fr;gap:80px;align-items:end}.proof-head p{color:var(--muted);line-height:1.85;font-size:14px}.proof-grid{margin-top:70px;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.proof-card{min-height:285px;padding:30px 26px;border-right:1px solid var(--line);position:relative;transition:.35s}.proof-card:last-child{border-right:0}.proof-card:hover{background:rgba(18,104,157,.08)}.proof-card>span{font-size:9px;letter-spacing:.18em;color:#3c7191}.proof-card h3{font-size:25px;margin:70px 0 15px}.proof-card p{color:var(--muted);font-size:12px;line-height:1.75}
.services{background:linear-gradient(135deg,#061b31,#031326)}.section-intro{display:grid;grid-template-columns:1fr .65fr;gap:80px;margin-top:28px;align-items:end}.section-intro p{color:var(--muted);line-height:1.8;font-size:14px}.service-list{margin-top:65px;border-top:1px solid var(--line)}.service-row{display:grid;grid-template-columns:80px 1fr 120px;gap:30px;align-items:center;padding:31px 0;border-bottom:1px solid var(--line);transition:.3s}.service-row:hover{padding-left:14px;background:linear-gradient(90deg,rgba(22,200,255,.06),transparent)}.service-no{font-size:10px;letter-spacing:.2em;color:#46708c}.service-row h3{font-size:27px;margin:0 0 8px}.service-row p{margin:0;color:var(--muted);font-size:13px;line-height:1.6}.service-row a{justify-self:end;color:#83ddff;font-size:11px;text-transform:uppercase;letter-spacing:.14em}.service-row a span{margin-left:8px}
