.impact{background:linear-gradient(180deg,#031326,#061b30)}.impact-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:90px}.impact p{max-width:600px;color:var(--muted);line-height:1.85;margin-top:28px}.stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line)}.stats div{padding:26px;background:#04172a;min-height:145px}.stats strong{display:block;font-family:"Space Grotesk";font-size:42px;color:var(--blue);letter-spacing:-.05em}.stats span{display:block;margin-top:7px;color:#9cb1c4;font-size:9px;line-height:1.45;letter-spacing:.12em;text-transform:uppercase}
.products{background:#f3f5f6;color:#07172a}.products .section-label{color:#0a8bbd}.products .section-label span{background:#0a8bbd;box-shadow:none}.products .section-intro p{color:#667789}.products .section-intro h2 span{color:#087eb0}.product-grid{margin-top:65px;display:grid;grid-template-columns:1fr 1fr;gap:18px}.product{background:#fff;border:1px solid #dbe3e8;transition:.35s;overflow:hidden}.product:hover{transform:translateY(-7px);box-shadow:0 25px 60px rgba(4,25,45,.12)}.product-art{height:300px;background:radial-gradient(circle at 75% 25%,rgba(22,200,255,.25),transparent 25%),linear-gradient(135deg,#06203a,#0a5d86 55%,#06162a);padding:28px;display:flex;flex-direction:column;justify-content:flex-end;color:#fff;position:relative;overflow:hidden}.product-art:after{content:"";position:absolute;width:330px;height:330px;border:1px solid rgba(255,255,255,.12);border-radius:50%;right:-120px;top:-120px;box-shadow:0 0 0 45px rgba(255,255,255,.025),0 0 0 90px rgba(255,255,255,.018)}.product-art-alt{background:radial-gradient(circle at 25% 20%,rgba(22,200,255,.24),transparent 25%),linear-gradient(135deg,#031326,#163c57 55%,#06172a)}.product-art span,.product-art strong,.product-art small{position:relative;z-index:2}.product-art span{font-size:8px;letter-spacing:.2em;color:#91e9ff}.product-art strong{font-family:"Space Grotesk";font-size:45px;letter-spacing:-.05em;margin:8px 0}.product-art small{font-size:10px;color:#b5cada}.product-info{padding:26px}.product-info>span{font-size:9px;letter-spacing:.2em;color:#168db7}.product-info h3{font-size:26px;margin:12px 0}.product-info p{color:#65798c;line-height:1.7;font-size:12px}.product-info a{display:inline-block;margin-top:10px;color:#067da9;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em}
.about{background:#031326}.about-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:100px;align-items:center}.about-mark{min-height:300px;display:flex;flex-direction:column;justify-content:center;padding:35px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(10,39,65,.65),rgba(2,14,27,.3));position:relative}.about-mark span{font-family:"Space Grotesk";font-size:76px;line-height:.8;letter-spacing:-.07em}.about-mark strong{font-size:12px;letter-spacing:.35em;color:var(--blue);margin-top:15px}.about-mark i{width:80px;height:2px;background:var(--gold);margin:28px 0 18px}.about-mark small{font-size:8px;letter-spacing:.2em;color:#6f8aa1}.about-grid p{color:var(--muted);line-height:1.85;max-width:690px}.about-grid p:first-of-type{margin-top:28px}.about-line{display:flex;align-items:center;gap:13px;margin-top:40px;color:#88a1b6;font-size:8px;letter-spacing:.2em}.about-line i{width:40px;height:1px;background:var(--line)}
.process{background:#f3f5f6;color:#07172a}.process .section-label{color:#0a8bbd}.process .section-label span{background:#0a8bbd;box-shadow:none}.process-head{display:flex;justify-content:space-between;align-items:end;gap:50px;margin-top:25px}.process-head h2 span{color:#087eb0}.process-head p{color:#657789;max-width:370px;line-height:1.7;font-size:13px}.process-grid{margin-top:65px;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #cbd6dd;border-bottom:1px solid #cbd6dd}.process-item{padding:30px 22px;min-height:220px;border-right:1px solid #cbd6dd}.process-item:last-child{border-right:0}.process-item>span{font-size:9px;letter-spacing:.2em;color:#0a8bbd}.process-item h3{font-size:27px;margin:65px 0 12px}.process-item p{font-size:12px;line-height:1.7;color:#6c7e8d}
.final-cta{position:relative;overflow:hidden;padding:125px 0;background:#031326;text-align:center}.final-cta .container{position:relative;z-index:2}.final-cta .section-label{justify-content:center}.final-cta h2{margin:20px auto;font-size:clamp(48px,6vw,82px)}.final-cta p{max-width:590px;margin:0 auto 30px;color:var(--muted);line-height:1.8}.cta-glow{position:absolute;width:500px;height:300px;left:50%;top:50%;transform:translate(-50%,-50%);background:rgba(0,145,255,.14);filter:blur(100px);animation:imageGlow 5s ease-in-out infinite}.cta-word{position:absolute;left:50%;bottom:-95px;transform:translateX(-50%);font-family:"Space Grotesk";font-weight:700;font-size:260px;letter-spacing:-.08em;color:rgba(15,117,182,.08);white-space:nowrap}
.contact{background:#f1f3f4;color:#07172a}.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:100px}.contact .section-label{color:#0a8bbd}.contact .section-label span{background:#0a8bbd;box-shadow:none}.contact-copy h2{margin-top:20px;color:#07172a}.contact-copy h2 span{color:#087eb0}.contact-copy>p{color:#687b8c;line-height:1.8;margin:28px 0}.contact-details{border-top:1px solid #d3dce1}.contact-details a,.contact-details div{display:block;padding:16px 0;border-bottom:1px solid #d3dce1;color:#173047;font-size:13px}.contact-details small{display:block;color:#7d91a1;font-size:8px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:6px}.contact-form{padding:34px;background:#fff;border:1px solid #d9e1e6}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}.contact-form label{display:block;color:#496073;font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:18px}.contact-form input,.contact-form textarea,.contact-form select{width:100%;margin-top:8px;border:1px solid #d6e0e6;background:#f8fafb;color:#07172a;padding:13px 14px;outline:none;border-radius:4px}.contact-form input:focus,.contact-form textarea:focus,.contact-form select:focus{border-color:#0a9ed0;box-shadow:0 0 0 3px rgba(10,158,208,.08)}.contact-form textarea{resize:vertical}.honeypot{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important}.form-status{font-size:11px;margin:15px 0 0}.form-status.success{color:#087b52}.form-status.error{color:#a43c2c}
.site-footer{background:#020b18;color:#8ca2b7;border-top:1px solid var(--line)}.footer-top{padding:55px 0 35px;display:grid;grid-template-columns:1fr 1fr auto;gap:30px;align-items:center}.footer-brand img{width:150px}.footer-top p{margin:0;font-size:12px}.footer-links{display:flex;gap:22px;font-size:11px}.footer-links a:hover{color:#fff}.footer-bottom{border-top:1px solid var(--line);padding:20px 0;display:flex;justify-content:space-between;font-size:9px;letter-spacing:.08em}.footer-bottom a{color:#69d9ff}
.reveal{opacity:0;transform:translateY(28px);transition:opacity .8s ease,transform .8s ease}.reveal.visible{opacity:1;transform:none}
