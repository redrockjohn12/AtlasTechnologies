* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #020812;
    color: #f4f8ff;
    line-height: 1.6;
    overflow-x: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
textarea {
    font: inherit;
}

.container {
    width: min(1180px, 90%);
    margin: 0 auto;
}

/* ================= HEADER ================= */

.header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(1, 6, 14, 0.92);
    border-bottom: 1px solid rgba(0, 132, 255, 0.2);
    backdrop-filter: blur(14px);
}

.nav {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo img {
    width: 220px;
    max-width: 45vw;
    display: block;
}

#main-nav {
    display: flex;
    align-items: center;
    gap: 36px;
}

#main-nav > a {
    position: relative;
    color: #b7c5d8;
    font-size: 14px;
    font-weight: 600;
    transition: 0.3s ease;
}

#main-nav > a:hover,
#main-nav > a.active {
    color: #1da1ff;
}

#main-nav > a:not(.nav-button)::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -10px;
    width: 0;
    height: 2px;
    background: #079cff;
    box-shadow: 0 0 10px #079cff;
    transition: width 0.3s ease;
}

#main-nav > a:hover::after,
#main-nav > a.active::after {
    width: 100%;
}

.nav-button {
    padding: 12px 22px;
    border-radius: 10px;
    background: linear-gradient(135deg, #09a4ff, #145bea);
    color: white !important;
    box-shadow: 0 0 25px rgba(0, 132, 255, 0.25);
}

.nav-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(0, 145, 255, 0.5);
}

.menu-toggle {
    display: none;
    border: 0;
    background: none;
    color: white;
    font-size: 28px;
    cursor: pointer;
}

/* ================= HERO ================= */

.hero {
    min-height: 650px;
    padding-top: 72px;
    position: relative;
    overflow: hidden;
    background:
        radial-gradient(circle at 80% 45%, rgba(0, 113, 255, 0.28), transparent 28%),
        radial-gradient(circle at 40% 80%, rgba(0, 65, 160, 0.12), transparent 35%),
        #020711;
}

.hero-background {
    position: absolute;
    inset: 0;
    opacity: 0.55;
    background:
        linear-gradient(110deg, transparent 40%, rgba(0, 136, 255, 0.12)),
        radial-gradient(ellipse at 85% 65%, #06182d 0%, transparent 45%);
}

.hero-glow {
    position: absolute;
    width: 700px;
    height: 700px;
    right: -250px;
    top: 10px;
    border-radius: 50%;
    border: 1px solid rgba(0, 157, 255, 0.35);
    box-shadow:
        0 0 80px rgba(0, 132, 255, 0.18),
        inset 0 0 80px rgba(0, 132, 255, 0.12);
    transform: rotate(-18deg);
}

.hero-content {
    min-height: 578px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    position: relative;
    z-index: 2;
}

.hero-text {
    padding: 55px 0;
}

.eyebrow,
.section-label {
    color: #09a8ff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 10px;
}

.hero h1 {
    max-width: 650px;
    font-size: clamp(42px, 5vw, 66px);
    line-height: 1.08;
    letter-spacing: -2px;
    margin-bottom: 22px;
}

.hero h1 span,
.section-intro h2 span,
.portfolio-heading h2 span,
.about h2 span,
.contact h2 span {
    display: block;
    color: #0ba7ff;
    text-shadow: 0 0 25px rgba(0, 145, 255, 0.3);
}

.hero-description {
    max-width: 560px;
    color: #9cafc5;
    font-size: 15px;
    line-height: 1.8;
}

.hero-buttons {
    display: flex;
    gap: 16px;
    margin-top: 30px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 23px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    transition: 0.3s ease;
}

.btn-primary {
    color: white;
    background: linear-gradient(135deg, #0aa9ff, #075ee8);
    box-shadow: 0 8px 25px rgba(0, 112, 255, 0.2);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(0, 145, 255, 0.4);
}

.btn-secondary {
    border: 1px solid rgba(50, 150, 255, 0.55);
    color: #d7e8ff;
    background: rgba(2, 17, 35, 0.55);
}

.btn-secondary:hover {
    background: rgba(8, 55, 105, 0.5);
    border-color: #0ba7ff;
}

.hero-features {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 32px;
}

.hero-features div {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #8da4bc;
    font-size: 11px;
}

.feature-icon {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #00a7ff;
    background: rgba(0, 123, 255, 0.1);
    border: 1px solid rgba(0, 143, 255, 0.25);
    font-size: 10px;
    font-weight: 800;
}

/* Hero logo */

.hero-visual {
    height: 100%;
    min-height: 500px;
    display: grid;
    place-items: center;
    position: relative;
}

.planet-glow {
    position: absolute;
    width: 620px;
    height: 320px;
    border-radius: 50%;
    background:
        radial-gradient(ellipse at center,
        rgba(5, 78, 150, 0.5),
        rgba(2, 22, 48, 0.5) 45%,
        transparent 70%);
    transform: rotate(-18deg);
}

.hero-logo-wrap {
    position: relative;
    z-index: 2;
    text-align: center;
    animation: floatLogo 6s ease-in-out infinite;
}

.hero-logo-wrap img {
    width: min(500px, 45vw);
    max-width: 100%;
    filter:
        drop-shadow(0 0 18px rgba(0, 126, 255, 0.65))
        drop-shadow(0 0 45px rgba(0, 91, 255, 0.2));
}

.hero-tagline {
    margin-top: -25px;
    color: #13a8ff;
    font-size: 10px;
    letter-spacing: 4px;
    font-weight: 700;
}

@keyframes floatLogo {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-12px);
    }
}

/* ================= SECTIONS ================= */

.section {
    position: relative;
    padding: 70px 0;
    border-top: 1px solid rgba(24, 117, 200, 0.15);
}

.services {
    background:
        radial-gradient(circle at 50% 0%, rgba(0, 96, 190, 0.08), transparent 40%),
        #020914;
}

.section-intro {
    margin-bottom: 30px;
}

.section-intro h2,
.portfolio-heading h2,
.about h2,
.contact h2 {
    font-size: clamp(27px, 3vw, 38px);
    line-height: 1.15;
    margin-bottom: 10px;
}

.section-intro h2 span {
    display: inline;
}

.section-intro > p:last-child,
.portfolio-heading p,
.about-text > p,
.contact-info > p {
    color: #8196ad;
    font-size: 13px;
}

/* ================= SERVICES ================= */

.services-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
}

.service-card {
    min-height: 180px;
    padding: 23px 20px;
    border-radius: 9px;
    background:
        linear-gradient(145deg, rgba(5, 25, 49, 0.75), rgba(2, 12, 27, 0.8));
    border: 1px solid rgba(13, 111, 211, 0.25);
    box-shadow: inset 0 0 30px rgba(0, 91, 180, 0.03);
    transition: 0.35s ease;
}

.service-card:hover {
    transform: translateY(-7px);
    border-color: rgba(0, 151, 255, 0.7);
    box-shadow:
        0 15px 35px rgba(0, 67, 130, 0.2),
        0 0 25px rgba(0, 129, 255, 0.08);
}

.service-icon {
    width: 39px;
    height: 39px;
    display: grid;
    place-items: center;
    margin-bottom: 16px;
    border-radius: 50%;
    color: #09a9ff;
    background: rgba(0, 137, 255, 0.1);
    border: 1px solid rgba(0, 150, 255, 0.3);
    font-size: 12px;
    font-weight: 800;
}

.service-card h3 {
    font-size: 14px;
    line-height: 1.35;
    margin-bottom: 8px;
}

.service-card p {
    color: #71869d;
    font-size: 11px;
    line-height: 1.6;
}

/* ================= PORTFOLIO ================= */

.portfolio {
    background: #010711;
}

.portfolio-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
}

.view-projects {
    padding: 10px 17px;
    border: 1px solid #087fcf;
    border-radius: 9px;
    color: #18aaff;
    font-size: 11px;
    white-space: nowrap;
    transition: 0.3s;
}

.view-projects:hover {
    background: rgba(0, 140, 255, 0.1);
}

.portfolio-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.project-card {
    overflow: hidden;
    border-radius: 9px;
    background: #041020;
    border: 1px solid rgba(13, 105, 194, 0.25);
    transition: 0.3s ease;
}

.project-card:hover {
    transform: translateY(-6px);
    border-color: rgba(0, 143, 255, 0.55);
}

.project-image {
    height: 145px;
    position: relative;
    overflow: hidden;
}

.project-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to top,
        rgba(1, 8, 18, 0.7),
        transparent 60%
    );
}

.project-image span {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    padding: 5px 8px;
    border-radius: 5px;
    color: #5bc4ff;
    background: rgba(0, 25, 55, 0.8);
    border: 1px solid rgba(0, 148, 255, 0.3);
    font-size: 8px;
}

.skincare {
    background:
        linear-gradient(135deg, rgba(255, 180, 180, 0.3), rgba(25, 10, 30, 0.8)),
        radial-gradient(circle at 30% 30%, #db9b9b, #241126 70%);
}

.evo {
    background:
        radial-gradient(circle at 70% 50%, rgba(0, 164, 255, 0.5), transparent 30%),
        linear-gradient(135deg, #020711, #071c3c 50%, #050b1d);
}

.dashboard {
    background:
        linear-gradient(135deg, rgba(0, 116, 255, 0.2), transparent),
        linear-gradient(110deg, #061729, #071e37 50%, #020b16);
}

.ecommerce {
    background:
        linear-gradient(135deg, rgba(44, 82, 26, 0.5), rgba(14, 25, 19, 0.8)),
        radial-gradient(circle at 65% 35%, #7d8f50, #152519 65%);
}

.project-content {
    padding: 16px;
}

.project-content h3 {
    font-size: 14px;
    margin-bottom: 5px;
}

.project-content p {
    color: #788da4;
    font-size: 10px;
    line-height: 1.6;
    min-height: 48px;
}

.project-content a {
    display: inline-block;
    margin-top: 10px;
    color: #0aa8ff;
    font-size: 10px;
    font-weight: 700;
}

/* ================= ABOUT ================= */

.about {
    background:
        radial-gradient(circle at 80% 50%, rgba(0, 112, 220, 0.12), transparent 35%),
        #020b17;
}

.about-content {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 70px;
    align-items: center;
}

.about-text h2 {
    margin-bottom: 18px;
}

.about-text h2 span {
    display: inline;
}

.about-text > p {
    max-width: 620px;
    line-height: 1.8;
    margin-bottom: 25px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.stat {
    text-align: center;
    padding: 25px 10px;
    border-left: 1px solid rgba(0, 130, 230, 0.2);
}

.stat strong {
    display: block;
    color: #eef7ff;
    font-size: 28px;
    text-shadow: 0 0 20px rgba(0, 147, 255, 0.35);
}

.stat span {
    display: block;
    margin-top: 5px;
    color: #6e849b;
    font-size: 9px;
}

/* ================= CONTACT ================= */

.contact {
    background:
        radial-gradient(circle at 15% 80%, rgba(0, 101, 210, 0.13), transparent 35%),
        #020a15;
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 25px;
}

.contact-info {
    padding-right: 25px;
}

.contact h2 {
    margin-bottom: 16px;
}

.contact h2 span {
    display: inline;
}

.contact-info > p {
    line-height: 1.8;
    max-width: 500px;
}

.contact-details {
    margin-top: 28px;
    display: grid;
    gap: 18px;
}

.contact-item {
    display: flex;
    align-items: center;
    gap: 13px;
}

.contact-icon {
    width: 35px;
    height: 35px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #05a8ff;
    background: rgba(0, 136, 255, 0.12);
    border: 1px solid rgba(0, 147, 255, 0.25);
}

.contact-item small {
    display: block;
    color: #6f849b;
    font-size: 9px;
}

.contact-item a,
.contact-item span {
    display: block;
    color: #c4d4e6;
    font-size: 11px;
}

/* Form */

.contact-form {
    padding: 25px;
    border-radius: 12px;
    background: rgba(3, 18, 35, 0.75);
    border: 1px solid rgba(0, 112, 213, 0.28);
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.2);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    margin-bottom: 12px;
    padding: 13px 14px;
    outline: none;
    border-radius: 8px;
    border: 1px solid rgba(40, 115, 185, 0.3);
    background: rgba(1, 10, 21, 0.8);
    color: white;
    font-size: 11px;
    transition: 0.3s;
}

.contact-form textarea {
    resize: vertical;
    min-height: 120px;
}

.contact-form input:focus,
.contact-form textarea:focus {
    border-color: #079cff;
    box-shadow: 0 0 15px rgba(0, 140, 255, 0.1);
}

.contact-form .btn {
    width: 100%;
    border: none;
    cursor: pointer;
}

/* Contact feature cards */

.contact-features {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.contact-features > div {
    display: flex;
    gap: 10px;
    padding: 15px;
    border: 1px solid rgba(0, 116, 210, 0.2);
    border-radius: 8px;
    background: rgba(3, 20, 39, 0.55);
}

.contact-features strong {
    color: #08a7ff;
    font-size: 18px;
}

.contact-features b,
.contact-features small {
    display: block;
}

.contact-features b {
    font-size: 10px;
}

.contact-features small {
    color: #70859c;
    font-size: 8px;
}

/* ================= FOOTER ================= */

.footer {
    padding: 22px 0;
    border-top: 1px solid rgba(0, 113, 210, 0.2);
    background: #01060d;
}

.footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.footer-logo img {
    width: 150px;
}

.footer p,
.footer-motto {
    color: #60758b;
    font-size: 9px;
}

.footer-social {
    display: flex;
    gap: 10px;
}

.footer-social a {
    width: 25px;
    height: 25px;
    display: grid;
    place-items: center;
    color: #849ab0;
    border: 1px solid rgba(91, 133, 171, 0.25);
    border-radius: 50%;
    font-size: 8px;
}

.footer-social a:hover {
    color: #08a7ff;
    border-color: #08a7ff;
}

/* ================= RESPONSIVE ================= */

@media (max-width: 1000px) {

    .services-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .portfolio-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero-content {
        grid-template-columns: 1fr;
    }

    .hero {
        min-height: auto;
    }

    .hero-text {
        padding-top: 70px;
    }

    .hero-visual {
        min-height: 350px;
    }

    .hero-logo-wrap img {
        width: 400px;
        max-width: 70vw;
    }

    .about-content {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .contact-grid {
        grid-template-columns: 1fr;
    }

    .contact-features {
        grid-column: auto;
    }
}

@media (max-width: 720px) {

    .nav {
        min-height: 65px;
    }

    .logo img {
        width: 175px;
    }

    .menu-toggle {
        display: block;
    }

    #main-nav {
        position: absolute;
        top: 65px;
        left: 0;
        width: 100%;
        padding: 20px;
        display: none;
        flex-direction: column;
        align-items: stretch;
        gap: 18px;
        background: rgba(1, 7, 15, 0.98);
        border-bottom: 1px solid rgba(0, 135, 255, 0.2);
    }

    #main-nav.active {
        display: flex;
    }

    #main-nav > a {
        text-align: center;
    }

    #main-nav > a:not(.nav-button)::after {
        display: none;
    }

    .hero-content {
        min-height: auto;
    }

    .hero-text {
        padding-top: 65px;
        padding-bottom: 20px;
    }

    .hero h1 {
        font-size: 42px;
        letter-spacing: -1.5px;
    }

    .hero-description {
        font-size: 13px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .hero-features {
        gap: 13px;
    }

    .hero-visual {
        min-height: 300px;
    }

    .hero-glow {
        width: 500px;
        height: 500px;
        right: -220px;
    }

    .services-grid {
        grid-template-columns: 1fr;
    }

    .portfolio-grid {
        grid-template-columns: 1fr;
    }

    .portfolio-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .stat {
        border-left: 0;
        border-bottom: 1px solid rgba(0, 130, 230, 0.15);
        padding-bottom: 18px;
    }

    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .contact-features {
        grid-template-columns: 1fr;
    }

    .footer-content {
        flex-direction: column;
        text-align: center;
    }
}

@media (max-width: 420px) {

    .container {
        width: 92%;
    }

    .hero h1 {
        font-size: 36px;
    }

    .hero-features {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .hero-logo-wrap img {
        width: 320px;
    }

    .section {
        padding: 55px 0;
    }

    .contact-form {
        padding: 17px;
    }
}
